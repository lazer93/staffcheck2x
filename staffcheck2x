--==================== DETECTION HELPERS ====================
local function getCachedRank(plr, groupId)
    local key   = plr.UserId .. ":" .. tostring(groupId)
    local entry = rankCache[key]
    if entry and (os.clock() - entry.t) < RANK_CACHE_TTL then
        return entry.rank
    end
    local ok, rank = pcall(function() return plr:GetRankInGroup(groupId) end)
    if ok and type(rank) == "number" then
        rankCache[key] = { rank = rank, t = os.clock() }
        return rank
    end
    return 0
end

local function classifyRank(rank)
    if rank <= 0 then return nil end
    if rank >= STAFF_CONFIG.OwnerRankThreshold then return "owner"
    elseif rank >= STAFF_CONFIG.AdminRankThreshold then return "admin"
    elseif rank >= STAFF_CONFIG.ModRankThreshold then return "mod"
    end
    return nil
end

local function findAdminTool(plr)
    local function matchesTool(name)
        local lname = name:lower()
        for _, base in ipairs(STAFF_CONFIG.AdminToolNames) do
            if lname == base then return true end
            if lname:sub(1, #base) == base then
                local nextChar = lname:sub(#base + 1, #base + 1)
                if nextChar == " " or nextChar == "(" or nextChar == "[" then
                    return true
                end
            end
        end
        return false
    end
    local function checkContainer(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and matchesTool(item.Name) then
                return item
            end
        end
        return nil
    end
    local found = checkContainer(plr:FindFirstChild("Backpack"))
    if found then return found end
    if plr.Character then
        found = checkContainer(plr.Character)
    end
    return found
end

local function getCreatorGroupId()
    if game.CreatorType == Enum.CreatorType.Group then
        return game.CreatorId
    end
    return nil
end

local function getStaffLevel(plr)
    -- 1) Game creator (user-owned game)
    if STAFF_CONFIG.FlagCreator
        and game.CreatorType == Enum.CreatorType.User
        and plr.UserId == game.CreatorId then
        return "owner", "Game Creator"
    end

    -- 2) Game's own creator group rank
    local cgid = getCreatorGroupId()
    if cgid then
        local rank  = getCachedRank(plr, cgid)
        local level = classifyRank(rank)
        if level then
            return level, "Group rank " .. rank
        end
    end

    -- 3) Extra configured groups
    for gid, thresholds in pairs(STAFF_CONFIG.ExtraGroups) do
        if gid ~= cgid then
            local rank = getCachedRank(plr, gid)
            if rank > 0 then
                local oT = thresholds.owner or 255
                local aT = thresholds.admin or 200
                local mT = thresholds.mod   or 100
                local level
                if rank >= oT then level = "owner"
                elseif rank >= aT then level = "admin"
                elseif rank >= mT then level = "mod"
                end
                if level then
                    return level, "Group " .. gid .. " rank " .. rank
                end
            end
        end
    end

    -- 4) Known staff (manual override)
    local lname = plr.Name:lower()
    if STAFF_CONFIG.KnownStaff[lname] then
        return STAFF_CONFIG.KnownStaff[lname], "Known staff"
    end

    -- 5) Strict admin tool
    local tool = findAdminTool(plr)
    if tool then
        return "admin", "Admin tool: " .. tool.Name
    end

    -- 6) Roblox staff (opt-in, unreliable)
    if STAFF_CONFIG.CheckRobloxStaff then
        local rank = getCachedRank(plr, 1)
        if rank > 0 then
            return "admin", "Roblox group member"
        end
    end

    return nil
end

--==================== SCANNING =============================
local function countKnownStaff()
    local n = 0
    for _ in pairs(knownStaff) do n += 1 end
    return n
end

local function scanAllPlayers(warnIfEmpty)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local level, reason = getStaffLevel(plr)
            if level then
                local prev = knownStaff[plr.UserId]
                knownStaff[plr.UserId]       = level
                knownStaffReason[plr.UserId] = reason

                if prev ~= level then
                    local style  = STAFF_STYLES[level] or STAFF_STYLES.staff
                    local suffix = reason and (" [" .. reason .. "]") or ""
                    notify(level:upper() .. " — " .. plr.DisplayName ..
                           " (@" .. plr.Name .. ")" .. suffix, true, style)
                    if chamsEnabled then
                        applyStaffVisuals(plr, level)
                    end
                elseif chamsEnabled and not staffHighlights[plr.UserId] then
                    applyStaffVisuals(plr, level)
                end

                if not staffTracked[plr.UserId] then
                    staffTracked[plr.UserId] = true
                    plr.CharacterAdded:Connect(function()
                        if not chamsEnabled then return end
                        local lvl = knownStaff[plr.UserId]
                        if not lvl then return end
                        task.wait(0.3)
                        if chamsEnabled and knownStaff[plr.UserId] then
                            applyStaffVisuals(plr, lvl)
                        end
                    end)
                end
            else
                if knownStaff[plr.UserId] then
                    knownStaff[plr.UserId]       = nil
                    knownStaffReason[plr.UserId] = nil
                    removeStaffVisuals(plr.UserId)
                end
            end
        end
    end

    if warnIfEmpty then
        local n = countKnownStaff()
        if n == 0 and not hasWarnedNoStaff then
            hasWarnedNoStaff = true
            notify("No higher-ups detected in this server", false, EMPTY_STYLE)
        elseif n > 0 then
            hasWarnedNoStaff = false
        end
    end
end

--==================== DEEP SCAN (informational) ============
local function matchesAny(name, keywords)
    local lower = name:lower()
    for _, kw in ipairs(keywords) do
        if lower:find(kw, 1, true) then return kw end
    end
    return nil
end

local function deepScanAdminSystems()
    local found = { systems = {}, remotes = {}, guis = {} }
    local services = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
    }
    for sysName, names in pairs(STAFF_CONFIG.KnownSystems) do
        local matched = false
        for _, svc in ipairs(services) do
            for _, name in ipairs(names) do
                local inst = svc:FindFirstChild(name)
                if inst then
                    table.insert(found.systems, { name = sysName, instance = inst })
                    matched = true
                    break
                end
            end
            if matched then break end
        end
    end

    local containers = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("Workspace"),
        game:GetService("Lighting"),
    }
    local scanned = 0
    for _, container in ipairs(containers) do
        local ok, descendants = pcall(function() return container:GetDescendants() end)
        if ok and descendants then
            for _, desc in ipairs(descendants) do
                scanned += 1
                if scanned % 400 == 0 then task.wait() end
                local kw = matchesAny(desc.Name, STAFF_CONFIG.AdminKeywords)
                if kw then
                    local cls = desc.ClassName
                    if cls == "RemoteEvent" or cls == "RemoteFunction" then
                        table.insert(found.remotes, { name = desc.Name, class = cls })
                    elseif cls == "ScreenGui" or cls == "Folder"
                        or cls == "ModuleScript" or cls == "Configuration" then
                        local dup = false
                        for _, g in ipairs(found.guis) do
                            if g.name == desc.Name then dup = true break end
                        end
                        if not dup then
                            table.insert(found.guis, { name = desc.Name, class = cls })
                        end
                    end
                end
            end
        end
    end
    return found
end

local function runDeepScan()
    if deepScanRunning then return end
    deepScanRunning = true
    lastDeepScan = os.clock()

    local ok, result = pcall(deepScanAdminSystems)
    if not ok or not result then
        deepScanRunning = false
        notify("Deep scan failed — try again", false, EMPTY_STYLE)
        return
    end

    for _, sys in ipairs(result.systems) do
        if not detectedSystems[sys.name] then
            detectedSystems[sys.name] = true
            notify("Admin system: " .. sys.name, true, SYSTEM_STYLE)
        end
    end
    for _, r in ipairs(result.remotes) do
        local key = "remote:" .. r.name
        if not detectedSystems[key] then
            detectedSystems[key] = true
            notify("Admin remote: " .. r.name, true, SYSTEM_STYLE)
        end
    end
    for _, g in ipairs(result.guis) do
        local key = "gui:" .. g.name
        if not detectedSystems[key] then
            detectedSystems[key] = true
            notify("Admin panel: " .. g.name, true, SYSTEM_STYLE)
        end
    end
    if #result.systems == 0 and #result.remotes == 0 and #result.guis == 0 then
        if not detectedSystems["__none__"] then
            detectedSystems["__none__"] = true
            notify("No admin systems detected in this game", false, EMPTY_STYLE)
        end
    else
        detectedSystems["__none__"] = nil
    end

    deepScanRunning = false
end

--==================== SCAN LOOPS ===========================
local function startStaffScan()
    if staffScanRunning then return end
    staffScanRunning = true
    task.spawn(function()
        scanAllPlayers(false)
        task.wait(STAFF_CONFIG.InitialGraceTime)
        scanAllPlayers(true)
        runDeepScan()
        while staffScanRunning and staffAlertEnabled do
            task.wait(STAFF_CONFIG.ScanInterval)
            scanAllPlayers(true)
            if os.clock() - lastDeepScan >= STAFF_CONFIG.DeepScanInterval then
                runDeepScan()
            end
        end
        staffScanRunning = false
    end)
end

--==================== TOGGLE LOGIC =========================
local function refreshChams()
    if not chamsEnabled then
        removeAllStaffVisuals()
        return
    end
    for userId, level in pairs(knownStaff) do
        local plr = Players:GetPlayerByUserId(userId)
        if plr and plr.Character then
            applyStaffVisuals(plr, level)
        end
    end
end

local function setChams(state)
    chamsEnabled = state
    setToggleVisual(chamsTrack, chamsKnob, state)
    if state then
        if not staffAlertEnabled then
            notify("Tip: enable Staff Check first to detect higher-ups", false, EMPTY_STYLE)
        end
        notify("Higher Up Chams — ON", true)
        refreshChams()
    else
        notify("Higher Up Chams — OFF", false)
        removeAllStaffVisuals()
    end
end

local function setStaffCheck(state)
    staffAlertEnabled = state
    setToggleVisual(staffTrack, staffKnob, state)
    refreshBubbleColor()

    if state then
        hasWarnedNoStaff = false
        detectedSystems  = {}
        knownStaff       = {}
        knownStaffReason = {}
        staffTracked     = {}
        notify("Staff Check — ON (accurate detection…)", true)
        startStaffScan()
    else
        notify("Staff Check — OFF", false)
        staffScanRunning = false
        removeAllStaffVisuals()
        knownStaff       = {}
        knownStaffReason = {}
        staffTracked     = {}
        detectedSystems  = {}
        hasWarnedNoStaff = false
        if chamsEnabled then
            -- keep the toggle state but nothing to show
        end
    end
end

local function setEnabled(state)
    enabled = state
    setToggleVisual(multTrack, multKnob, state)
    refreshBubbleColor()
    notify(state and ("Tap Speed x" .. MULTIPLIER .. " — ON")
                or ("Tap Speed x" .. MULTIPLIER .. " — OFF"), state)
end

multTrack.Activated:Connect(function()  setEnabled(not enabled) end)
staffTrack.Activated:Connect(function() setStaffCheck(not staffAlertEnabled) end)
chamsTrack.Activated:Connect(function() setChams(not chamsEnabled) end)

